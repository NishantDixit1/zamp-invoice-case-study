# Extraction shells out to the `claude` CLI, authenticated against your Claude
# subscription (not a billed API key). Either:
#   - be logged in on this machine already (`claude login`), nothing to set here, or
#   - run `claude setup-token` and export the result as CLAUDE_CODE_OAUTH_TOKEN
#     before starting the backend (useful for headless/CI runs).
ANTHROPIC_MODEL=claude-sonnet-5
DATABASE_URL=sqlite:///./invoices.db
